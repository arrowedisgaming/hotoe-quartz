filters:
  and:
    - file.inFolder("recaps/questions")
formulas:
  status: if(note.answer, "Answered", "Open")
properties:
  note.question:
    displayName: Question
  note.session_asked:
    displayName: Asked in
  note.answer:
    displayName: Answer
  note.session_answered:
    displayName: Answered in
  note.notes:
    displayName: Notes
  formula.status:
    displayName: Status
views:
  - type: table
    name: All
    order:
      - formula.status
      - question
      - session_asked
      - answer
      - session_answered
      - notes
    sort:
      - property: question
        direction: ASC
      - property: formula.status
        direction: DESC
      - property: session_asked
        direction: ASC
    columnSize:
      note.question: 498
  - type: table
    name: Open
    filters:
      and:
        - "!note.answer"
    order:
      - question
      - session_asked
      - notes
    sort:
      - property: session_asked
        direction: ASC
  - type: table
    name: Answered
    filters:
      and:
        - note.answer
    order:
      - question
      - answer
      - session_asked
      - session_answered
    sort:
      - property: session_answered
        direction: ASC
